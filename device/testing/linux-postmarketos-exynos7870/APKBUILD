16c568c4cf39a78ee9bf401e2a286bec9310f6871aa447cfa094195209d4ec09f3e2d0880a3a3fa9a21b619aa79fd24800cfff1756db941f94d2fe8b8bd7a57e  config-postmarketos-exynos7870.aarch64
"
