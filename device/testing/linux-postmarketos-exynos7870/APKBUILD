# Kernel config based on defconfig and exynos7870.config
maintainer="methanal <kauschluss+methanal@disroot.org>"
pkgname=linux-postmarketos-exynos7870
pkgver=7.1.0_rc2
pkgrel=1
pkgdesc="Close-to-mainline kernel for Samsung Exynos 7870 devices"
arch="aarch64"
_carch="arm64"
_flavor="postmarketos-exynos7870"
url="https://github.com/yasstox/linux-exynos7870-gtaxlwifi"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bc
	bison
	clang
	elfutils-dev
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"

_owner="yasstox"
_repo="linux-exynos7870-gtaxlwifi"
_commit="c3db703cfeabb3c36c0f36ef71cbeecbc97d0a0c"
_config="config-$_flavor.aarch64"
_kmajver="$(echo "$pkgver" | sed 's/\..*$//')"

# Source
source="
        linux-$_commit.tar.gz::https://github.com/$_owner/$_repo/archive/$_commit.tar.gz
        $_config
"
builddir="$srcdir/$_repo-$_commit"

# pmbootstrap --envkernel exposes the already built Kbuild output as $srcdir.
if [ -f "$srcdir/Makefile" ] && [ -d "$srcdir/arch" ]; then
	builddir="$srcdir"
fi


prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 HOSTLDFLAGS="-fuse-ld=lld" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot

	# The bootloader does not support zipped kernels
	make install dtbs_install modules_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/"$_flavor"/kernel.release

	install -Dm644 "$builddir"/arch/"$_carch"/boot/Image \
		"$pkgdir"/boot/vmlinuz
}

sha512sums="
9802ccb0b3a5ebf8e5250682eb45a3e27081c615b565837a54a3fa60f30e216a3e5b97bd9116b14eae9fb66fb78081cb44eef344e95351ec1e39a5555a7cef43  linux-c3db703cfeabb3c36c0f36ef71cbeecbc97d0a0c.tar.gz
446d15f6160dc2045fdddca3f41cba0345ef8042948329a21500f8542b6f8e1685dfb1a75911e3c4264c72c63af74aa302c764e4480b21226aa642497d0f462e  config-postmarketos-exynos7870.aarch64
"
