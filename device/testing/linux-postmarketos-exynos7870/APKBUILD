52ea20defcb9bc1f593e1e4f425ee30390172ddcd4f9e63a50cc6876c4a976684485815f95b7a8c6caa597622c47a35c498db5f1da2264d1e2eb8cfb1ad46ecf  0001-arm64-dts-exynos7870-add-samsung-gtaxlwifi-board.patch
